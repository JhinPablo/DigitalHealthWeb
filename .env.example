# Copy this file to .env.docker for Docker Compose or to .env.production on the VPS.
# Replace every CHANGE_ME value before deploying publicly.

# PostgreSQL
POSTGRES_DB=fhir_salud_digital
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/fhir_salud_digital

# JWT / API keys
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
ACCESS_KEY=CHANGE_ME_MASTER_ACCESS_KEY
ADMIN_PERM_KEY=CHANGE_ME_ADMIN_PERMISSION_KEY
MEDICO_PERM_KEY=CHANGE_ME_MEDICO_PERMISSION_KEY
PACIENTE_PERM_KEY=CHANGE_ME_PACIENTE_PERMISSION_KEY

# CORS
# Local demo can use *. Production should use http://YOUR_DROPLET_IP or your final domain.
ALLOWED_ORIGINS=http://YOUR_DROPLET_IP

# Encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=medical-images
MINIO_SECURE=false

# Internal services
ML_SERVICE_URL=http://ml-service:8001
DL_SERVICE_URL=http://dl-service:8002
ORCHESTRATOR_URL=http://orchestrator:8003
MAX_WORKERS=4
